# Interface : active le mode serveur (sans cette variable, le site tourne sur les données de démonstration)
VITE_API_URL=/api

# Serveur (fonction Vercel api/index.ts) — à définir dans Vercel, jamais dans le code
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require
# Clé de signature des sessions : 32 caractères ou plus, ASCII uniquement (ex. openssl rand -hex 32)
JWT_SECRET=

# Email des billets (Resend, https://resend.com) : sans ces deux réglages, la commande reste valable et le billet reste
# consultable par le lien de la page de confirmation, mais aucun email ne part.
RESEND_API_KEY=
# Expéditeur : le domaine doit être vérifié chez Resend, par exemple « Event509 <billets@votre-domaine.com> »
MAIL_FROM=
# Adresse publique du site (liens des emails). Sur Vercel, l'adresse de production est détectée si elle manque.
SITE_URL=

# ---------- Codes de vérification par WhatsApp (API officielle Meta Cloud) ----------
# Sans META_ACCESS_TOKEN et META_PHONE_NUMBER_ID, le service reste désactivé : l'inscription et le changement de mot de passe
# fonctionnent comme avant. Dès qu'ils sont définis, le numéro WhatsApp devient obligatoire et vérifié à l'inscription.
# Jeton PERMANENT d'un « utilisateur système » (pas le jeton de test de 24 h), permissions whatsapp_business_messaging
# et whatsapp_business_management. Jamais dans le code, jamais côté navigateur.
META_ACCESS_TOKEN=
# Identifiant du numéro d'envoi (WhatsApp > Configuration de l'API)
META_PHONE_NUMBER_ID=
# Identifiant du compte WhatsApp Business (pour créer le modèle de message)
META_WABA_ID=
# Secret de l'application Meta : sert à vérifier la signature des accusés de livraison (webhook)
META_APP_SECRET=
# Mot de votre choix (32 caractères ou plus, ex. openssl rand -hex 24), à saisir aussi chez Meta pour le webhook
META_VERIFY_TOKEN=
# Version de l'API Graph
META_GRAPH_API_VERSION=v21.0
# Modèle de catégorie AUTHENTICATION approuvé par Meta et sa langue (voir docs/OTP-WHATSAPP.md)
META_OTP_TEMPLATE=event509_otp
META_OTP_LANG=fr
# « false » seulement si le modèle n'a pas de bouton « Copier le code »
META_OTP_COPY_BUTTON=true
# Facultatif : secret pour les empreintes des codes (sinon JWT_SECRET est utilisé)
OTP_PEPPER=

# ---------- Connexion Google (OpenID Connect) ----------
# Sans ces trois réglages, le site garde les formulaires d'origine (rien ne change). Dès qu'ils sont définis, « Continuer avec Google »
# devient la seule façon de créer un compte ; les anciens comptes se connectent par « J'ai un ancien compte » puis associent Google.
# Voir docs/AUTH-GOOGLE.md (création du client OAuth dans Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Adresse de retour déclarée chez Google : https://<votre-site>/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---------- Passkeys (WebAuthn) ----------
# Facultatif : par défaut, l'adresse du site (SITE_URL). À définir seulement si le site est servi sur plusieurs domaines.
# L'identifiant (RP ID) est le domaine, sans « https:// » ; l'origine est l'adresse complète.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# Facultatif : secret pour les empreintes des codes de récupération (sinon JWT_SECRET est utilisé)
AUTH_PEPPER=
# NE JAMAIS définir en production : COOKIE_INSECURE=1 (cookies sans « Secure », pour un essai local en http uniquement)
# NE JAMAIS définir en production : GOOGLE_AUTH_URL, GOOGLE_TOKEN_URL, GOOGLE_JWKS_URL (réservés aux tests avec un faux Google)

# --- Ajouts (audit de sécurité) : tous à définir dans Vercel (Production), jamais ici ---
# Annonce des mises à jour de l'application (secret partagé ; l'envoi depuis l'administration n'en a pas besoin)
APP_ANNOUNCE_SECRET=
# Tâches planifiées (rappels, nettoyages) : secret du cron Vercel
CRON_SECRET=
# Notifications push : clé de compte de service Firebase (JSON complet sur une seule ligne)
FIREBASE_SERVICE_ACCOUNT=
# Paiement en ligne (passerelle MonCash / NatCash / KashPaw / carte)
PAY_CLIENT_ID=
# Empreinte SHA-256 du certificat de signature de l'APK (facultatif : valeur par défaut dans le code ; à changer seulement si la clé change)
APP_SIGNER_SHA256=
# Compte administrateur créé par `npm run db:setup` (sinon un mot de passe aléatoire est généré et affiché une fois)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Développement local seulement (ignorés en production) : COOKIE_INSECURE=1, WEBHOOK_ALLOW_PRIVATE=1
