# Interface : active le mode serveur (sans cette variable, le site tourne sur les données de démonstration)
VITE_API_URL=/api

# Serveur (fonction Vercel api/index.ts) — à définir dans Vercel, jamais dans le code
DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require
# Clé de signature des sessions : 32 caractères ou plus, ASCII uniquement (ex. openssl rand -hex 32)
JWT_SECRET=

# Email des billets (Resend, https://resend.com) : sans ces deux réglages, la commande reste valable et le billet reste
# consultable par le lien de la page de confirmation, mais aucun email ne part.
RESEND_API_KEY=
# Expéditeur : le domaine doit être vérifié chez Resend, par exemple « Event509 <billets@votre-domaine.com> »
MAIL_FROM=
# Adresse publique du site (liens des emails). Sur Vercel, l'adresse de production est détectée si elle manque.
SITE_URL=
