{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/app/event509.apk",
      "destination": "/api?path=app/download"
    },
    {
      "source": "/app/version.json",
      "destination": "/api?path=app/version"
    },
    {
      "source": "/e/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=e&slug=:slug"
    },
    {
      "source": "/o/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=o&slug=:slug"
    },
    {
      "source": "/api/whatsapp/webhook",
      "destination": "/api/whatsapp-webhook"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/api?path=seo/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api?path=seo/sitemap&name=index"
    },
    {
      "source": "/sitemap-:name.xml",
      "destination": "/api?path=seo/sitemap&name=:name"
    },
    {
      "source": "/og/:kind/:slug.png",
      "destination": "/api?path=og&kind=:kind&slug=:slug"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=home"
    },
    {
      "source": "/explorer",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=explore"
    },
    {
      "source": "/telecharger",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=download"
    },
    {
      "source": "/organisateur-verifie",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=program"
    },
    {
      "source": "/cgu",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=terms"
    },
    {
      "source": "/confidentialite",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=privacy"
    },
    {
      "source": "/remboursement",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=refund"
    },
    {
      "source": "/ambassadeurs",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|Pinterest|SkypeUriPreview|Signal|Viber|vkShare|redditbot|Embedly|Googlebot|Google-InspectionTool|bingbot|DuckDuckBot|YandexBot|Applebot|Baiduspider|Mastodon|Bluesky).*"
        }
      ],
      "destination": "/api?path=share&kind=ambassador"
    },
    {
      "source": "/((?!api/|assets/|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(admin|organisateur|compte|connexion|inscription|mot-de-passe-oublie|reinitialiser|verifier-email|retour-paiement|commande|billets|favoris|notifications|fil|desinscription|revente|widget|app)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/e/:slug/achat",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/((?!widget/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-L33V/Z7f/mfhhO29CJKiN8PZQfuXchj5KXY7oetxFZc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; media-src 'self' blob: https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=(self), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/widget/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-L33V/Z7f/mfhhO29CJKiN8PZQfuXchj5KXY7oetxFZc='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; frame-src 'self' blob:; media-src 'self' blob: https:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https:; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=(self), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app/event509.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"EVENT509.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "includeFiles": "server-assets/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 13 * * *"
    }
  ]
}
